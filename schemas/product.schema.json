{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/product.schema.json",
  "title": "WooCommerce Import Product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productType",
    "name",
    "sku",
    "category",
    "status"
  ],
  "properties": {
    "productType": {
      "type": "string",
      "enum": [
        "simple",
        "variable"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "publish",
        "pending",
        "private"
      ]
    },
    "regularPrice": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "salePrice": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "stockStatus": {
      "type": "string",
      "enum": [
        "instock",
        "outofstock",
        "onbackorder"
      ]
    },
    "manageStock": {
      "type": "boolean"
    },
    "stockQuantity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "weight": {
      "type": [
        "string",
        "number",
        "null"
      ]
    }
  }
}
